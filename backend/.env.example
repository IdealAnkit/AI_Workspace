# Application
ENVIRONMENT=development
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=aiworkspace
POSTGRES_DB=aiworkspace

# JWT (replace SECRET_KEY with a unique, high-entropy value before production)
SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Documents
DOCUMENT_STORAGE_PROVIDER=minio
DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
DOCUMENT_DELETE_STORAGE_OBJECTS=false
SIGNED_URL_EXPIRATION=900
DOCUMENT_PROCESSING_ENABLED=true
DOCUMENT_PROCESSING_MAX_CONTENT_BYTES=26214400

# Object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-workspace
MINIO_SECURE=false

# Indexing (offline deterministic embedding provider)
INDEXING_ENABLED=true
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=128
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=200
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_workspace_documents
INDEX_BATCH_SIZE=32

# Retrieval (no LLM calls)
DEFAULT_TOP_K=8
MAX_TOP_K=50
DEFAULT_SCORE_THRESHOLD=0.0
ENABLE_HYBRID_SEARCH=true
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
MAX_CONTEXT_TOKENS=4000
DEFAULT_RANKER=default_score
