# Application
ENVIRONMENT=development
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=aiworkspace
POSTGRES_DB=aiworkspace

# JWT (replace SECRET_KEY with a unique, high-entropy value before production)
SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
